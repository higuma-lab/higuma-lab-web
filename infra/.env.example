# CDK に渡す環境依存の値（docs/design.md 7.2）。このファイルを .env にコピーして使う。.env はコミットしない
# AWS アカウントは、実行時のプロファイル（AWS_PROFILE）から求める

# サイトのドメイン（apex）。www.<ドメイン> は apex へリダイレクトする（D-003）
DOMAIN_NAME=higuma-lab.jp

# デプロイを許可する GitHub リポジトリ（owner/repo）と environment 名（OIDC の信頼条件に使う）
DEPLOY_GITHUB_REPOSITORY=higuma-lab/higuma-lab-web
DEPLOY_GITHUB_ENVIRONMENT=production

# GitHub の OIDC プロバイダーがアカウントに既にある場合は、その ARN を指定する（1アカウントに1つしか作れないため）
# GITHUB_OIDC_PROVIDER_ARN=
