---
/** 全ページ共通のレイアウト（docs/design.md 12.4）。アプリ用ページは AppDocLayout を使う */
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Analytics from '../components/seo/Analytics.astro';
import HeadBase from '../components/seo/HeadBase.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import { SITE } from '../config/site';
import { organizationJsonLd, websiteJsonLd } from '../lib/structured-data';
import '../styles/global.css';

type SeoProps = Parameters<typeof SeoHead>[0];

type Props = Omit<SeoProps, 'lang' | 'alternates'>;

const site = Astro.site ?? new URL('https://higuma-lab.jp');
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <HeadBase />
    <SeoHead {...Astro.props} />
    <noscript>
      <link rel="stylesheet" href="/noscript.css" />
    </noscript>
    {!Astro.props.noindex && <JsonLd data={[organizationJsonLd(site), websiteJsonLd(site)]} />}
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }
</style>
