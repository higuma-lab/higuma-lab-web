---
/** 制作物・取り組みの一覧（D-001）。件数が少なくても成立するように、種別ラベルの説明を添える */
import { getCollection } from 'astro:content';
import PageHeader from '../../components/layout/PageHeader.astro';
import Section from '../../components/layout/Section.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import WorkList from '../../components/sections/WorkList.astro';
import Badge from '../../components/ui/Badge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortWorks, WORK_KIND_LABELS, type WorkKind } from '../../lib/works';

const works = sortWorks(await getCollection('works'));
const kinds: { kind: WorkKind; note: string }[] = [
  { kind: 'own-product', note: 'ひぐま開発室が自分で企画・開発したもの' },
  { kind: 'sample', note: '実際のご依頼ではなく、見本として作ったもの' },
  { kind: 'experiment', note: '新しい技術を試すために作ったもの' },
  { kind: 'client', note: 'お客様のご依頼で作り、掲載の許可をいただいたもの' },
];
const description =
  'ひぐま開発室の制作物・取り組み。自社のアプリやこのサイトについて、課題・設計・技術・工夫した点を紹介します。';
---

<BaseLayout title="制作物・取り組み" description={description}>
  <PageHeader
    title="制作物・取り組み"
    lead="これまでに作ったもの・取り組んでいることです。それぞれに、どのような立場で作ったものかを示すラベルを付けています。"
  />
  <Section alt labelledby="works-list-heading">
    <h2 id="works-list-heading" class="visually-hidden">
      一覧
    </h2>
    <WorkList works={works} />
  </Section>
  <Section narrow labelledby="kinds-heading">
    <h2 id="kinds-heading">ラベルについて</h2>
    <dl class="kinds">
      {kinds.map(({ kind, note }) => (
        <div>
          <dt>
            <Badge tone={kind}>{WORK_KIND_LABELS[kind]}</Badge>
          </dt>
          <dd>{note}</dd>
        </div>
      ))}
    </dl>
  </Section>
  <CtaBanner />
</BaseLayout>

<style>
  h2 {
    font-size: 1.25rem;
  }

  .kinds {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
  }

  .kinds div {
    display: grid;
    gap: var(--space-1) var(--space-4);
    align-items: center;
  }

  @media (min-width: 640px) {
    .kinds div {
      grid-template-columns: 9em 1fr;
    }
  }

  dd {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
