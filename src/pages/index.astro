---
/** トップページ（docs/design.md 4.4） */
import { getCollection } from 'astro:content';
import Section from '../components/layout/Section.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import Features from '../components/sections/Features.astro';
import Hero from '../components/sections/Hero.astro';
import PostList from '../components/sections/PostList.astro';
import ProfileSummary from '../components/sections/ProfileSummary.astro';
import ServiceGroups from '../components/sections/ServiceGroups.astro';
import WorkList from '../components/sections/WorkList.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';
import { sortWorks } from '../lib/works';

const works = sortWorks(await getCollection('works')).slice(0, 3);
const posts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout>
  <Hero />
  <ServiceGroups />
  <Features />
  <Section alt labelledby="works-heading">
    <SectionHeading
      id="works-heading"
      label="Works"
      title="制作物・取り組み"
      lead="自社のアプリやこのサイトなど、これまでに作ったもの・取り組んでいることです。"
    />
    <WorkList works={works} />
    <p class="more">
      <a href="/works/">制作物の一覧を見る</a>
    </p>
  </Section>
  <ProfileSummary />
  {posts.length > 0 && (
    <Section labelledby="blog-heading">
      <SectionHeading id="blog-heading" label="Blog" title="ブログ" />
      <PostList posts={posts} />
      <p class="more">
        <a href="/blog/">記事の一覧を見る</a>
      </p>
    </Section>
  )}
  <CtaBanner />
</BaseLayout>

<style>
  .more {
    margin-top: var(--space-8);
    font-weight: 700;
  }
</style>
