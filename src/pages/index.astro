---
/**
 * トップページ。
 * TODO: Phase 5 で docs/design.md 4.4 の構成（サービス、特徴、制作物、プロフィール、ブログ、CTA）を実装する。
 */
import Button from '../components/ui/Button.astro';
import { SITE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>
        <span class="eyebrow">{SITE.name}</span>
        <span class="copy">{SITE.tagline}</span>
      </h1>
      <p class="description">{SITE.description}</p>
      <div class="actions">
        <Button href="/contact/">相談する</Button>
        <Button href="/services/" variant="secondary">
          サービスを見る
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-12) 0 var(--space-16);
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-accent-text);
    font-size: var(--text-small);
    letter-spacing: 0.08em;
  }

  .eyebrow::before {
    content: '';
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .copy {
    color: var(--color-brand);
    font-size: var(--text-hero);
    line-height: 1.4;
  }

  .description {
    max-width: 34em;
    margin: 20px 0 var(--space-8);
    font-size: 1.0625rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
