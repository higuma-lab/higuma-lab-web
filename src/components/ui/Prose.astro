---
/** Markdown 本文のスタイル（docs/design.md 12.4）。見出し・リスト・表・コード・引用 */
interface Props {
  /** ブログ本文は 17px（12.2） */
  size?: 'body' | 'article';
}

const { size = 'body' } = Astro.props;
---

<div class:list={['prose', { 'prose-article': size === 'article' }]}>
  <slot />
</div>

<style>
  .prose {
    max-width: 42rem;
  }

  .prose-article {
    font-size: var(--text-article);
  }

  .prose > :global(* + *) {
    margin-top: 1.25em;
  }

  .prose :global(h2) {
    margin-top: 2.5em;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .prose :global(h3) {
    margin-top: 2em;
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.75em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5em;
  }

  .prose :global(li + li) {
    margin-top: 0.25em;
  }

  .prose :global(li::marker) {
    color: var(--color-accent);
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding: var(--space-2) var(--space-6);
    border-left: 4px solid var(--color-accent);
    background: var(--color-accent-tint);
    border-radius: 0 var(--radius-small) var(--radius-small) 0;
  }

  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--color-brand-tint);
    font-size: 0.9em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-small);
    line-height: 1.6;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-small);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--color-surface-alt);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .prose :global(img) {
    border-radius: var(--radius-small);
  }
</style>
