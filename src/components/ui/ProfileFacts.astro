---
/** 対応地域・開発経験（D-009・D-039） */
import { PROFILE } from '../../data/profile';
---

<dl class="facts">
  <div>
    <dt>対応地域</dt>
    <dd>{PROFILE.area}</dd>
  </div>
  <div>
    <dt>開発経験</dt>
    <dd>{PROFILE.experienceYears}</dd>
  </div>
</dl>
<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin: var(--space-4) 0 0;
    font-size: var(--text-small);
  }

  .facts div {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  dt {
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
    font-weight: 700;
  }
</style>
