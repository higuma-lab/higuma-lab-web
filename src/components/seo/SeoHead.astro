---
/**
 * title・description・canonical・OGP・Twitter Card を一元生成する（docs/design.md 6.1）。
 */
import { SITE } from '../../config/site';
import {
  DEFAULT_OG_IMAGE,
  absoluteUrl,
  buildTitle,
  siteNameFor,
  type SeoLang,
} from '../../lib/seo';

export interface Alternate {
  hreflang: string;
  href: string;
}

interface Props {
  /** ページ名。省略するとトップページの形式になる */
  title?: string | undefined;
  description?: string | undefined;
  /** OGP 画像のパスまたは URL。省略すると共通画像（docs/design.md 12.8） */
  image?: string | undefined;
  type?: 'website' | 'article';
  lang?: SeoLang;
  noindex?: boolean;
  /** hreflang の対応ページ（アプリ用ページの日英など） */
  alternates?: Alternate[];
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  lang = 'ja',
  noindex = false,
  alternates = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://higuma-lab.jp');
const fullTitle = buildTitle(title, lang);
const locale = lang === 'ja' ? SITE.locale : 'en_US';
const canonical = absoluteUrl(Astro.url.pathname, site);
const imageUrl = absoluteUrl(image ?? DEFAULT_OG_IMAGE.path, site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{/* noindex のページ（404 など）は URL が実在しないため、canonical と og:url を出さない */}
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={absoluteUrl(alt.href, site)} />
))}

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.fullName} ブログ`}
  href={absoluteUrl('/rss.xml', site)}
/>

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteNameFor(lang)} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={locale} />
<meta property="og:image" content={imageUrl} />
{!image && (
  <>
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE.height)} />
    <meta property="og:image:alt" content={DEFAULT_OG_IMAGE.alt[lang]} />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />
